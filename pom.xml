<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aliyun.odps</groupId>
    <artifactId>flink-connector-maxcompute-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <modules>
        <module>flink/1.16</module>
        <module>flink/1.17</module>
        <module>flink/1.20</module>
    </modules>

    <name>MaxCompute Connector for Apache Flink®</name>
    <description>Apache Flink Source, Sink and Catalog connector for Alibaba Cloud MaxCompute.</description>
    <url>https://www.alibabacloud.com/product/maxcompute</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>maxcompute</id>
            <name>MaxCompute Team</name>
            <organization>Alibaba Cloud</organization>
            <organizationUrl>https://www.alibabacloud.com/</organizationUrl>
        </developer>
    </developers>
    <scm>
        <url>${connector.scm.url}</url>
        <connection>${connector.scm.connection}</connection>
        <developerConnection>${connector.scm.connection}</developerConnection>
        <tag>${connector.scm.tag}</tag>
    </scm>

    <properties>
        <maven.test.skip>false</maven.test.skip>
        <!--
            JVM flags for the unit/integration test fork. Empty by default; the jdk17-plus
            profile fills it with the add-opens flags that Flink's ClosureCleaner needs from
            JDK 16 on. Without them DynamicShuffleSmokeTest fails with InaccessibleObjectException
            (3 of its 5 cases), which looks like a product bug but is a test-runtime gap.
        -->
        <connector.test.argLine></connector.test.argLine>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <connector.scm.url>https://github.com/aliyun/maxcompute-connector-for-apache-flink</connector.scm.url>
        <connector.scm.connection>scm:git:https://github.com/aliyun/maxcompute-connector-for-apache-flink.git</connector.scm.connection>
        <connector.scm.tag>HEAD</connector.scm.tag>
        <maxcompute.e2e.allow-write>false</maxcompute.e2e.allow-write>
        <connector.public.build>false</connector.public.build>
        <connector.release.artifacts>false</connector.release.artifacts>
        <skipTests>false</skipTests>
        <skipITs>false</skipITs>
        <coverage.argLine></coverage.argLine>
        <flink.version>1.20.4</flink.version>
        <flink.line>1.20</flink.line>
        <connector.root>${project.basedir}</connector.root>
        <scala.binary.version>2.12</scala.binary.version>
        <odps.sdk.version>0.61.2-public</odps.sdk.version>
        <arrow.version>17.0.0</arrow.version>
        <!-- compile for local run -->
        <tunnel.table.impl.scope>compile</tunnel.table.impl.scope>
        <table.api.scope>provided</table.api.scope>
        <odps.sdk.scope>provided</odps.sdk.scope>
        <hadoop.shaded.scope>provided</hadoop.shaded.scope>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keep the bundled SDK dependency closure identical across Flink runtimes. -->
            <dependency>
                <groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.26.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.18.0</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>credentials-java</artifactId>
                <version>1.0.2</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>credentials-api</artifactId>
                <version>1.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>
        <!-- core dependencies -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-shaded-hadoop-2-uber</artifactId>
            <version>2.4.1-7.0</version>
            <scope>${hadoop.shaded.scope}</scope>
        </dependency>
        <!-- Odps dependencies -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>
        <dependency>
            <groupId>com.aliyun.odps</groupId>
            <artifactId>odps-sdk-core</artifactId>
            <version>${odps.sdk.version}</version>
            <scope>${odps.sdk.scope}</scope>
            <exclusions>
                <!-- Java SE supplies StAX on the supported JDK 17 runtime. -->
                <exclusion><groupId>stax</groupId><artifactId>stax-api</artifactId></exclusion>
                <exclusion><groupId>stax</groupId><artifactId>stax</artifactId></exclusion>
                <exclusion><groupId>xpp3</groupId><artifactId>xpp3</artifactId></exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <artifactId>aliyun-java-auth</artifactId>
                    <groupId>com.aliyun</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.aliyun.odps</groupId>
            <artifactId>odps-sdk-commons</artifactId>
            <version>${odps.sdk.version}</version>
            <scope>${odps.sdk.scope}</scope>
            <exclusions>
                <exclusion><groupId>stax</groupId><artifactId>stax-api</artifactId></exclusion>
                <exclusion><groupId>stax</groupId><artifactId>stax</artifactId></exclusion>
                <exclusion><groupId>xpp3</groupId><artifactId>xpp3</artifactId></exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.aliyun.odps</groupId>
            <artifactId>odps-sdk-table-api</artifactId>
            <version>${odps.sdk.version}</version>
            <scope>${odps.sdk.scope}</scope>
            <exclusions>
                <exclusion><groupId>stax</groupId><artifactId>stax-api</artifactId></exclusion>
                <exclusion><groupId>stax</groupId><artifactId>stax</artifactId></exclusion>
                <exclusion><groupId>xpp3</groupId><artifactId>xpp3</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>netty-common</artifactId>
                    <groupId>io.netty</groupId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-core</artifactId>
            <version>${arrow.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>netty-buffer</artifactId>
                    <groupId>io.netty</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>netty-common</artifactId>
                    <groupId>io.netty</groupId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-compression</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <!-- for odps sdk 0.47.0 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.119.Final</version>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <type>jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-configuration2</artifactId>
            <version>2.15.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${connector.root}/src/main/java</sourceDirectory>
        <testSourceDirectory>${connector.root}/src/test/java</testSourceDirectory>
        <pluginManagement><plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>flink-shim</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${flink.shim.source}</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.12</version>
                <executions>
                    <execution><id>coverage-agent</id><goals><goal>prepare-agent</goal></goals><configuration><propertyName>coverage.argLine</propertyName><append>true</append><includes><include>org.apache.flink.odps.*</include><include>com.aliyun.odps.type.TypeInfoParser</include></includes></configuration></execution>
                    <execution><id>coverage-report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!--
                        *SystemTest.java cases need real MaxCompute credentials and network
                        access and create/drop tables when they run, so they must not fire in a
                        plain "mvn test". Run one explicitly with -Dtest=<ClassName>, which
                        overrides this exclusion.
                    -->
                    <excludes>
                        <exclude>**/*SystemTest.java</exclude>
                    </excludes>
                    <excludedGroups>org.apache.flink.odps.test.util.MaxComputeIntegration</excludedGroups>
                    <failIfNoTests>true</failIfNoTests>
                    <argLine>@{coverage.argLine} ${connector.test.argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>write-version-info</id>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-resources"/>
                                <echo file="${project.build.directory}/generated-resources/version.properties"
                                      append="false">
                                    odps.sdk.version=${odps.sdk.version}
                                    flink.version=${flink.version}
                                    connector.version=${project.version}
                                    flink.line=${flink.line}
                                </echo>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins></pluginManagement>
        <resources>
            <resource>
                <directory>${connector.root}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                    <include>licenses/**</include>
                </includes>
            </resource>
            <resource>
                <directory>${connector.root}/src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource><directory>${connector.root}/src/test/resources</directory></testResource>
            <testResource>
                <directory>${connector.root}</directory>
                <targetPath>META-INF</targetPath>
                <includes><include>LICENSE</include><include>NOTICE</include></includes>
            </testResource>
        </testResources>
    </build>

    <profiles>
        <profile>
            <id>coverage-check</id>
            <build><pluginManagement><plugins><plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
                <executions><execution><id>coverage-gate</id><phase>verify</phase><goals><goal>check</goal></goals>
                    <configuration><rules><rule><element>BUNDLE</element><limits><limit>
                        <counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum>
                    </limit></limits></rule></rules></configuration>
                </execution></executions>
            </plugin></plugins></pluginManagement></build>
        </profile>
        <profile>
            <id>jdk17-plus</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <properties>
                <connector.test.argLine>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.math=ALL-UNNAMED --add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED</connector.test.argLine>
            </properties>
        </profile>
        <profile>
            <id>public</id>
            <properties>
                <connector.public.build>true</connector.public.build>
                <table.api.scope>compile</table.api.scope>
                <odps.sdk.scope>compile</odps.sdk.scope>
            </properties>
            <build>
                <pluginManagement><plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>provided-consumer-classpath</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>build-classpath</goal></goals>
                                <configuration>
                                    <includeScope>provided</includeScope>
                                    <outputFile>${project.build.directory}/provided-classpath.txt</outputFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>public-dependency-tree</id>
                                <phase>prepare-package</phase>
                                <goals><goal>tree</goal></goals>
                                <configuration>
                                    <outputType>json</outputType>
                                    <outputFile>${project.build.directory}/public-dependency-tree.json</outputFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <executions>
                            <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                        </executions>
                        <configuration>
                            <includes><include>**/PublicArtifactIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <argLine>@{coverage.argLine} ${connector.test.argLine}</argLine>
                            <systemPropertyVariables>
                                <connector.shaded.jar>${project.build.directory}/${project.build.finalName}-shaded.jar</connector.shaded.jar>
                                <connector.provided.classpath>${project.build.directory}/provided-classpath.txt</connector.provided.classpath>
                                <connector.dependency.tree>${project.build.directory}/public-dependency-tree.json</connector.dependency.tree>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.2</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <minimizeJar>false</minimizeJar>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <artifactSet>
                                        <includes>
                                            <!-- Include here the dependencies you want to be packed in your
                                                                      fat jar -->
                                            <include>*:*</include>
                                        </includes>
                                    </artifactSet>
                                    <relocations>
                                        <relocation>
                                            <pattern>com.google.common</pattern>
                                            <shadedPattern>flink.connector.odps.com.google.common</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.google.protobuf</pattern>
                                            <shadedPattern>flink.connector.odps.com.google.protobuf</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.fasterxml.jackson</pattern>
                                            <shadedPattern>flink.connector.odps.com.fasterxml.jackson</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.google.flatbuffers</pattern>
                                            <shadedPattern>flink.connector.odps.com.google.flatbuffers</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.apache.arrow</pattern>
                                            <shadedPattern>flink.connector.odps.org.apache.arrow</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>io.netty</pattern>
                                            <shadedPattern>flink.connector.odps.io.netty</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.google.gson</pattern>
                                            <shadedPattern>flink.connector.odps.com.google.gson</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.aliyun.odps</pattern>
                                            <shadedPattern>flink.connector.odps.com.aliyun.odps</shadedPattern>
                                        </relocation>
                                    </relocations>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                            <resource>META-INF/NOTICE</resource>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                            <resource>reference.conf</resource>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins></pluginManagement>
            </build>
        </profile>
        <profile>
            <id>emulator</id>
            <build><pluginManagement><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                    <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    <configuration>
                        <includes><include>**/emulator/*ITCase.java</include></includes>
                        <failIfNoTests>true</failIfNoTests>
                        <argLine>@{coverage.argLine} ${connector.test.argLine}</argLine>
                        <systemPropertyVariables><emulator.endpoint>${emulator.endpoint}</emulator.endpoint></systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins></pluginManagement></build>
        </profile>
        <profile>
            <id>maxcompute-integration</id>
            <build><pluginManagement><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                    <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    <configuration>
                        <!-- Keep raw credential-bearing failure/output text out of report files.
                             The runner/CI collects a redacted console log and counts. -->
                        <disableXmlReport>true</disableXmlReport>
                        <useFile>false</useFile>
                        <includes combine.children="append">
                            <include>**/LatestPartitionE2EITCase.java</include>
                            <include>**/DynamicShuffleSinkRecoverySystemTest.java</include>
                        </includes>
                        <failIfNoTests>true</failIfNoTests>
                        <argLine>@{coverage.argLine} ${connector.test.argLine}</argLine>
                        <systemPropertyVariables>
                            <maxcompute.e2e.allow-write>${maxcompute.e2e.allow-write}</maxcompute.e2e.allow-write>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins></pluginManagement></build>
        </profile>
        <profile>
            <id>release-artifacts</id>
            <properties><connector.release.artifacts>true</connector.release.artifacts></properties>
            <build><pluginManagement><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.0.0</version>
                    <executions><execution><id>javadoc-legal-material</id><phase>verify</phase><goals><goal>run</goal></goals>
                        <configuration><target>
                            <!-- Runs before the release GPG goal; sign the final jar bytes. -->
                            <zip destfile="${project.build.directory}/${project.build.finalName}-javadoc.jar" update="true">
                                <zipfileset dir="${connector.root}" includes="LICENSE,NOTICE" prefix="META-INF"/>
                            </zip>
                        </target></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration><doclint>none</doclint><failOnError>true</failOnError></configuration>
                    <executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions>
                </plugin>
            </plugins></pluginManagement></build>
        </profile>
        <profile>
            <id>release</id>
            <build><pluginManagement><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.0.0</version>
                    <executions><execution><id>release-legal-review</id><phase>validate</phase><goals><goal>run</goal></goals>
                        <configuration><target>
                            <loadfile property="release.legal.catalog" srcFile="${connector.root}/licenses/third-party.json"/>
                            <fail message="Unresolved third-party redistribution material; see licenses/README.md.">
                                <condition><contains string="${release.legal.catalog}" substring="review-required"/></condition>
                            </fail>
                        </target></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                    <executions><execution><id>release-preconditions</id><goals><goal>enforce</goal></goals>
                        <configuration><rules>
                            <requireJavaVersion><version>[17,18)</version></requireJavaVersion>
                            <requireReleaseDeps/>
                            <requireProperty><property>connector.public.build</property><regex>true</regex></requireProperty>
                            <requireProperty><property>connector.release.artifacts</property><regex>true</regex></requireProperty>
                            <requireProperty><property>connector.release.approval</property><regex>.+</regex><message>Supply the verified open-source approval reference.</message></requireProperty>
                            <requireProperty><property>connector.scm.url</property><regex>https://.+</regex><message>Supply the approved public source repository URL.</message></requireProperty>
                            <requireProperty><property>connector.scm.connection</property><regex>scm:git:https://.+</regex></requireProperty>
                            <requireProperty><property>connector.scm.tag</property><regex>(?!HEAD$).+</regex><message>Supply the exact public release tag.</message></requireProperty>
                            <requireProperty><property>gpg.keyname</property><regex>[A-Fa-f0-9]{40}</regex><message>Supply the approved signing-key fingerprint.</message></requireProperty>
                            <requireProperty><property>maven.test.skip</property><regex>false</regex></requireProperty>
                            <requireProperty><property>skipTests</property><regex>false</regex></requireProperty>
                            <requireProperty><property>skipITs</property><regex>false</regex></requireProperty>
                        </rules></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration><bestPractices>true</bestPractices></configuration>
                    <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.9.0</version>
                    <extensions>true</extensions>
                    <configuration><publishingServerId>central</publishingServerId><autoPublish>false</autoPublish></configuration>
                </plugin>
            </plugins></pluginManagement><plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId></plugin>
                <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><extensions>true</extensions></plugin>
            </plugins></build>
        </profile>
    </profiles>


    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

</project>
